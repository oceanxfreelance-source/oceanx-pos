# --- core
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://oceanx:oceanx_dev@localhost:5432/oceanx_dev
# Public URL of the web app (used in password-reset / invitation links)
APP_URL=http://localhost:5173
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Set to true behind HTTPS (always true in production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs)
TRUST_PROXY=0

# --- sessions
BUSINESS_SESSION_IDLE_MINUTES=720
BUSINESS_SESSION_ABSOLUTE_HOURS=168
SUPERADMIN_SESSION_IDLE_MINUTES=30
SUPERADMIN_SESSION_ABSOLUTE_HOURS=12

# --- brute force protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- mail: "log" (dev only — prints links to server log) or "smtp"
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM="OceanX <no-reply@example.com>"
STORAGE_DIR=./storage
