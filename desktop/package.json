{
  "name": "oceanx-pos-desktop",
  "productName": "OceanX POS",
  "version": "1.0.3",
  "description": "OceanX POS for restaurants and caf\u00e9s \u2014 Windows desktop app",
  "author": "OceanX",
  "private": true,
  "main": "src/main.js",
  "oceanx": {
    "serverUrl": "https://oceanx-pos-oceanx1.vercel.app"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "resedit": "^2.0.0"
  },
  "build": {
    "appId": "app.oceanx.pos",
    "productName": "OceanX POS",
    "artifactName": "OceanX-POS-Setup-${version}.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OceanX POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://oceanx-pos-oceanx1.vercel.app/desktop"
      }
    ]
  }
}
